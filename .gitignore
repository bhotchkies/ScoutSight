# ── Maven build output ────────────────────────────────────────────────────────
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ── IntelliJ IDEA ─────────────────────────────────────────────────────────────
.idea/modules.xml
.idea/jarRepositories.xml
.idea/compiler.xml
.idea/libraries/
*.iws
*.iml
*.ipr

# ── IntelliJ artifact output ──────────────────────────────────────────────────
/out/

# ── Eclipse ───────────────────────────────────────────────────────────────────
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# ── NetBeans ──────────────────────────────────────────────────────────────────
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# ── VS Code ───────────────────────────────────────────────────────────────────
.vscode/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store

# ── Node / React apps ─────────────────────────────────────────────────────────
node_modules/
camp-scheduler/node_modules/
admin-console/node_modules/

# ── Generated HTML reports ────────────────────────────────────────────────────
# Contains scout PII (names, BSA member IDs) and embedded secrets (sheetsUrl).
# Never commit — regenerate locally from input CSVs.
/output/

# ── Input data ────────────────────────────────────────────────────────────────
# BSA advancement CSVs contain scout PII. Must not be committed.
/inputdata/

# ── Secrets ───────────────────────────────────────────────────────────────────
# The Apps Script web app URL (admin console) is stored in browser localStorage
# only and never written to any file in this repo. If that changes, add it here.
*.env
.env*
secrets.*
